{
  "name": "@zequel/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Zequel Desktop — local-first AI-assisted development and codebase research environment.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"vite\" \"npm:electron:dev\"",
    "electron:dev": "tsc -p tsconfig.electron.json && wait-on tcp:5173 && cross-env ZEQUEL_DESKTOP_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/main.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && npm run build:renderer",
    "package": "npm run build && electron-builder",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@uiw/react-codemirror": "^4.25.10",
    "@codemirror/view": "^6.43.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/language": "^6.12.3",
    "@lezer/highlight": "^1.2.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-sql": "^6.10.0",
    "lucide-react": "^0.564.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "^22",
    "@vitejs/plugin-react": "^4.3.4",
    "@tailwindcss/postcss": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
